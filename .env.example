# Alchemy CLI loads this file from .env with Node --env-file.
# Copy this file to .env. Keep .env out of git.
# Use separate Alchemy stages for local, preview, and production.
# Physical names use <base>-<stage>. Logical resource IDs stay fixed.
# Names use lowercase letters, digits, and hyphens. Full names: 3-63 chars.
DB_NAME=social-db
R2_BUCKET_NAME=social-media
QUEUE_NAME=social-jobs
DLQ_NAME=social-failed-jobs
WORKER_NAME=social-web

# Set private values. Encryption key: base64 for 32 random bytes.
ALCHEMY_PASSWORD=
SECRET_ENCRYPTION_KEY=

# Local values only. Supply approved HTTPS URLs for production.
APP_ORIGIN=http://localhost:3200
AUTH_CALLBACK_URL=http://localhost:3200/auth/callback
AUTH_CLIENT_ID=yopem
# Set to 1 only for local E2E fixtures. Deployment rejects this mode.
SOCIAL_E2E=0

X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
BLUESKY_CLIENT_ID=
META_API_VERSION=v25.0
# Comma-separated HTTPS origins approved for TikTok media.
TIKTOK_VERIFIED_MEDIA_ORIGINS=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
YOUTUBE_WEBHOOK_SECRET=
YOUTUBE_WEBHOOK_TOPICS=
